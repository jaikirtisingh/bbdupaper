# ========================================================
# EduVault Backend Production Environment Configuration
# ========================================================

# Server Port
PORT=5000
NODE_ENV=production

# JWT Authentication Secret (Generate a strong 32+ char secret)
JWT_SECRET=your_super_secure_jwt_secret_key_change_in_production_2026

# Permanent Cloud Database (MongoDB Atlas Free M0 Cluster)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/eduvault?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_user:your_password@cluster0.xxxxx.mongodb.net/eduvault?retryWrites=true&w=majority

# Permanent Cloud PDF Storage (Cloudinary Free Tier)
# Found on your Cloudinary Dashboard: https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend Allowed Origin (Your Vercel deployment URL)
FRONTEND_URL=https://eduvault.vercel.app
